# Vercel production server settings. Add these as private Vercel environment variables.
# Do not commit real credentials or place server secrets in VITE_* variables.
NODE_ENV=production
PORT=8080

# Temporary local cache; production records are persisted in Supabase.
DATA_DIR=/tmp/gloryday-pharma

# Required: replace with a unique password between 8 and 85 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional staff accounts. Set passwords between 8 and 85 characters.
# Example: [{"identifier":"catalogue","password":"LONG_RANDOM_SECRET","role":"Gestionnaire Catalogue","name":"Gestionnaire Catalogue"}]
STAFF_ACCOUNTS_JSON=[]

# Optional external AI feature. Not required for authentication or orders.
GEMINI_API_KEY=

# Required for the live Supabase-backed application in production.
# Copy the secret server key from Supabase into the host's private secret manager.
# Never use a publishable/anon key here and never prefix this value with VITE_.
# Set the URL or project ref for the intended environment (staging or production).
# If both are set, they must refer to the same Supabase project.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
