# Gloryday Pharma - Environment Configuration Example
# Copy this file to .env and provide your actual values (never commit secrets)

# Optional Supabase / PostgreSQL configuration for external persistent database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://user:password@host:5432/gloryday_db

# Gemini API (if server-side features are enabled)
GEMINI_API_KEY=
