# Gloryday Pharma Gabon - Production Environment Configuration
# Copy this file to .env and provide your actual keys (never commit secret keys)

NODE_ENV=production

# Supabase Production Configuration (Linked Project: kqvfoltosjrjvghaizpd)
SUPABASE_PROJECT_REF=kqvfoltosjrjvghaizpd
SUPABASE_URL=https://kqvfoltosjrjvghaizpd.supabase.co
VITE_SUPABASE_URL=https://kqvfoltosjrjvghaizpd.supabase.co

# Supabase Public Anon Key (supports both SUPABASE_ANON_KEY and VITE_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional Server-Side Supabase / PostgreSQL Direct Connection
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.kqvfoltosjrjvghaizpd.supabase.co:5432/postgres

# Gemini API (if server-side features are enabled)
GEMINI_API_KEY=

# Production Admin Password (defaults to Gloryday@2026! if not set)
ADMIN_PASSWORD=
